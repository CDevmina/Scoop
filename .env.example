# Copy to .env and fill in. Never commit .env.

# Backend
JWT_SECRET=change-me-to-a-long-random-string
REDIS_PASSWORD=change-me
# Leave MONGO_URI and REDIS_URL unset to use the mongodb and redis containers.
# For Atlas and Upstash, set them, for example:
# MONGO_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/scoopCinema
# REDIS_URL=rediss://default:PASS@xxxxx.upstash.io:6379
FRONTEND_URL=http://localhost
NODE_ENV=development

# Frontend (baked into the bundle at build time)
VITE_API_URL=http://localhost:5001
# Defaults to VITE_API_URL when empty
VITE_SOCKET_URL=
VITE_PAYPAL_CLIENT_ID=
